# Copy to .env and adjust. Compose reads .env automatically for every command,
# so build and run stay in sync.
#
#   cp .env.example .env

GO_VERSION=1.27

# Node major version, used only by the differential harness.
NODE_MAJOR=22

# Linux only: match the container user to your own so files written into the
# bind-mounted source tree are owned by you rather than by root.
#
#   printf 'UID=%s\nGID=%s\n' "$(id -u)" "$(id -g)" >> .env
#
# Docker Desktop on macOS and Windows remaps ownership itself; leave these as
# they are there.
UID=1000
GID=1000
